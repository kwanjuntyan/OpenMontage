  "glossary": [
    {
      "id": "glo-01",
      "preferred_term": "誠信",
      "definition": "坦率真誠待人、處事公平公正，遵守法規、信守承諾，言行一致以贏得長期信任。",
      "aliases": [
        "誠實守信",
        "Integrity"
      ],
      "forbidden_aliases": [
        "表面奉承",
        "粉飾太平"
      ]
    },
    {
      "id": "glo-02",
      "preferred_term": "勤奮",
      "definition": "建立於「價值」與「高效」之上，精益求精、追求卓越，不懈追求進步與成功。",
      "aliases": [
        "高效精益",
        "Diligence"
      ],
      "forbidden_aliases": [
        "盲目加班",
        "形式主義磨工時"
      ]
    },
    {
      "id": "glo-03",
      "preferred_term": "敏捷",
      "definition": "預見問題、洞察機會，運用科學方法決策，小步快跑並保持彈性隨時修正。",
      "aliases": [
        "小步快跑",
        "Agility"
      ],
      "forbidden_aliases": [
        "盲目衝動",
        "朝令夕改"
      ]
    },
    {
      "id": "glo-04",
      "preferred_term": "分享",
      "definition": "持開放態度與利他思維，樂於提供支援與分享成果，建立知識與資源共享機制。",
      "aliases": [
        "利他共享",
        "Sharing"
      ],
      "forbidden_aliases": [
        "資訊孤島",
        "密技私藏"
      ]
    },
    {
      "id": "glo-05",
      "preferred_term": "合作",
      "definition": "具團隊意識，相互尊重、開放溝通、共擔責任，跨單位協力實現共同目標。",
      "aliases": [
        "團隊協同",
        "Collaboration"
      ],
      "forbidden_aliases": [
        "各自為政",
        "相互踢皮球"
      ]
    },
    {
      "id": "glo-06",
      "preferred_term": "共榮",
      "definition": "引領員工、客戶及合作夥伴認同經營理念，共鑄良好夥伴關係與永續繁榮生態系。",
      "aliases": [
        "生態共贏",
        "Prosperity"
      ],
      "forbidden_aliases": [
        "零和博弈",
        "單邊獨占"
      ]
    },
    {
      "id": "glo-07",
      "preferred_term": "EPS + ESG",
      "definition": "鴻海永續經營方程式，獲利能力（EPS）與環境社會公司治理（ESG）並重且雙軌並進。",
      "aliases": [
        "永續雙E方程式",
        "EPS plus ESG"
      ],
      "forbidden_aliases": [
        "純獲利導向"
      ]
    },
    {
      "id": "glo-08",
      "preferred_term": "BOL",
      "definition": "Build, Operate, Localize（建構、營運、在地化），鴻海創新之在地化合作與生態構建商業模式。",
      "aliases": [
        "建構營運在地化",
        "BOL模式"
      ],
