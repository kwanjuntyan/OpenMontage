    {
      "id": "shot_1.1.5",
      "script_section_id": "shot_1.1.5",
      "type": "character_scene",
      "start_seconds": 25.0,
      "end_seconds": 30.0,
      "narrative_role": "resolution",
      "description": "極度微距推至小鼴鼠戴回護目鏡的臉部。澄澈晶亮的圓眼睛透過厚實凸面鏡片，無比生動地映出旋轉的銀河星座。眼角悄悄滑落一顆被星光照亮的晶瑩淚珠，小鼴鼠嘴角泛起滿足而溫柔的微笑，畫面在璀璨微光中漸漸溫暖淡出。",
      "shot_language": {
        "shot_size": "extreme_close_up",
        "camera_movement": "dolly_in",
        "lens_mm": 135,
        "lighting_key": "rim_lit",
        "depth_of_field": "shallow",
        "color_temperature": "mixed"
      },
      "transition_in": "cut",
      "transition_out": "fade_to_black",
      "hero_moment": false,
      "shot_intent": "完美收束情緒，將浩瀚宇宙的壯觀轉化為內心最細膩深沈的感動，留下永恆的治癒回音",
      "information_role": "留下久久難以忘懷的溫暖、治癒與純粹童心",
      "character_actions": [
        {
          "character_id": "mole_hero",
          "emotion": "深深被觸動的幸福與寧靜",
          "action_sequence": [
            "瞳孔放大映射出旋轉星河",
            "眼角凝聚出一顆晶瑩淚珠輕輕滑落",
            "雙頰泛起溫暖微紅，嘴角微笑"
          ],
          "dialogue": "鏡片裡倒映著整個宇宙。原來，世界如此美麗。"
        }
      ],
