      "end_seconds": 11.0,
      "narrative_role": "build_tension",
      "description": "夜色下的草甸地面微微隆起，泥土碎屑崩解。一隻沾著草屑的粉紅小鼻子破土而出，左右警惕嗅聞，接著金屬護目鏡鏡面探出地面，反射出微弱夜光。",
      "shot_language": {
        "shot_size": "close_up",
        "camera_movement": "tilt_up",
        "lens_mm": 85,
        "lighting_key": "rim_lit",
        "depth_of_field": "shallow",
        "color_temperature": "mixed"
      },
      "transition_in": "cut",
      "transition_out": "cut",
      "hero_moment": false,
      "shot_intent": "製造首次接觸外界地表的懸念與破土萌感，旁白點出尋找微光的冒險動機",
      "information_role": "讓觀眾屏息期待小鼴鼠即將看見的世界",
      "character_actions": [
        {
          "character_id": "mole_hero",
          "emotion": "警惕與期待",
          "action_sequence": [
            "頂起土壤碎塊",
            "粉紅鼻子左右快速抽動嗅探",
            "頭頂護目鏡破土現身"
          ],
          "dialogue": "今晚，牠決定第一次鑽出泥土，尋找傳說中的微光。"
        }
      ],
      "render_stages": [
        "R2I",
        "I2V"
      ],
