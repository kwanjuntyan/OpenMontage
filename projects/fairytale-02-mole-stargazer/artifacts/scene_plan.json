      "start_seconds": 11.0,
      "end_seconds": 18.0,
      "narrative_role": "transition",
      "description": "小鼴鼠整個身子奮力拔出土洞，一屁股跌坐在柔軟的三葉草叢中。牠像小狗一樣歡快地抖動全身甩掉泥土，蓬鬆的毛髮在夜風中舒展開來，雙手推起護目鏡揉了揉眼睛。",
      "shot_language": {
        "shot_size": "medium",
        "camera_movement": "steadicam",
        "lens_mm": 50,
        "lighting_key": "blue_hour",
        "depth_of_field": "medium",
        "color_temperature": "cool"
      },
      "transition_in": "cut",
      "transition_out": "cut",
      "hero_moment": false,
      "shot_intent": "展現小鼴鼠可愛逗趣的性格魅力，營造脫離地底後的輕鬆與自由感",
      "information_role": "觀眾感受主角徹底來到地表空間的開闊轉換",
      "character_actions": [
        {
          "character_id": "mole_hero",
          "emotion": "歡快與放鬆",
          "action_sequence": [
            "翻滾落坐在草地上",
            "全身毛髮劇烈抖動甩出泥塵",
            "用肉嘟嘟的小爪子把護目鏡推至額頭揉眼睛",
            "夜風吹過毛髮微微飄揚"
          ],
          "dialogue": "夜風輕輕吹散了泥屑，草甸上的螢火蟲悄悄亮起……"
        }
      ],
      "render_stages": [
        "R2I",
