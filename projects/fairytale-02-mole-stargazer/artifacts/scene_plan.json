      "narrative_role": "introduce_subject",
      "description": "在地底幽暗的土穴中，一盞懸掛的小油燈散發出溫暖的鎢絲微光。小鼴鼠仔細調整頭上的雙筒黃銅護目鏡，大眼睛中充滿興奮與專注，尖銳的小爪子快速刨動鬆軟的泥土。",
      "shot_language": {
        "shot_size": "medium_close",
        "camera_movement": "dolly_in",
        "lens_mm": 50,
        "lighting_key": "tungsten_warm",
        "depth_of_field": "shallow",
        "color_temperature": "warm"
      },
      "transition_in": "fade_from_black",
      "transition_out": "cut",
      "hero_moment": false,
      "shot_intent": "建立地底主角的生活環境與探索渴望，配合童話說書人引領觀眾進入純真世界",
      "information_role": "溫暖建立主角形象，引導觀眾共情小鼴鼠的好奇心",
      "character_actions": [
        {
          "character_id": "mole_hero",
          "emotion": "好奇與專注",
          "action_sequence": [
            "雙爪輕扶黃銅護目鏡調整鏡帶",
            "抽動粉色小鼻子深吸一口氣",
            "揮動前爪刨開頭頂泥土"
          ],
          "dialogue": "在無人知曉的地底深處，有隻戴著黃銅護目鏡的小小探險家……"
        }
      ],
      "render_stages": [
        "R2I",
        "I2V"
      ],
