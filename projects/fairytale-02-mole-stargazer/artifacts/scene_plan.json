    {
      "id": "shot_1.1.4",
      "script_section_id": "shot_1.1.4",
      "type": "character_scene",
      "start_seconds": 18.0,
      "end_seconds": 25.0,
      "narrative_role": "deliver_payload",
      "description": "小鼴鼠停下動作，緩緩抬頭——鏡頭以壯麗的 Crane Up 飛速攀升拉開！地平線急速展開，原本微小的視角瞬間昇華成一片震撼蒼穹：無垠的深靛青夜空、奔騰的紫金星雲與億萬顆閃耀星辰橫跨天際，地面上的小鼴鼠在星空下化作一個純真的剪影。",
      "shot_language": {
        "shot_size": "extreme_wide",
        "camera_movement": "crane_up",
        "lens_mm": 14,
        "lighting_key": "volumetric",
        "depth_of_field": "deep",
        "color_temperature": "cool"
      },
      "transition_in": "cut",
      "transition_out": "cut",
      "hero_moment": true,
      "shot_intent": "全片核心高潮 (Hero Moment)！以極致尺度對比呈現宇宙壯美，旁白讚嘆後留白給交響樂爆發",
      "information_role": "帶給觀眾無比強烈的視覺震撼與心靈撫慰",
      "character_actions": [
        {
          "character_id": "mole_hero",
          "emotion": "無比敬畏與驚嘆",
          "action_sequence": [
            "仰起頭部定格",
            "嘴巴微張屏住呼吸",
            "小爪子不自主地緩緩下垂"
          ],
          "dialogue": "直到牠抬起頭——整座浩瀚的星河，在眼前溫柔綻放。"
        }
      ],
      "render_stages": [
        "R2I",
        "I2V"
      ],
