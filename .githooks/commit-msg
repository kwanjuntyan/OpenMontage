#!/bin/sh
# OpenMontage Commit-Msg Gatekeeper
# Validates both commit message syntax AND staged content classification.

if command -v python3 >/dev/null 2>&1; then
    PY_BIN=python3
elif command -v python >/dev/null 2>&1; then
    PY_BIN=python
elif command -v py >/dev/null 2>&1; then
    PY_BIN=py
else
    # Fallback if Python is not in PATH
    exit 0
fi

$PY_BIN - "$1" << 'EOF'
import sys
import re
import os
import subprocess

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")

commit_msg_file = sys.argv[1]
try:
    with open(commit_msg_file, "r", encoding="utf-8", errors="ignore") as f:
        lines = [line.strip() for line in f.readlines() if line.strip() and not line.startswith("#")]
except Exception:
    sys.exit(0)

if not lines:
    sys.exit(0)

msg = lines[0]

# Allow special Git commits
if msg.startswith("Merge ") or msg.startswith("Revert ") or msg.startswith("Initial commit"):
    sys.exit(0)

# -------------------------------------------------------------
# 1. Commit Message Syntax Validation
# -------------------------------------------------------------
# Category A: Code & Infrastructure
pattern_cat_a = r"^(feat|fix|docs|test|refactor|chore|perf|ci|style|build)(\([a-zA-Z0-9_\-./]+\))?:\s+.{3,}"

# Category B: Course Content & Recipes
pattern_cat_b = r"^(content|data)\([a-zA-Z0-9_\-./]+\):\s+.{3,}"

is_cat_a = bool(re.match(pattern_cat_a, msg, re.IGNORECASE))
is_cat_b = bool(re.match(pattern_cat_b, msg, re.IGNORECASE))

if not is_cat_a and not is_cat_b:
    print("\n" + "=" * 70)
    print("[X] [OpenMontage 規範守門員 - 語法錯誤] Commit 訊息不符合團隊規範！")
    print("=" * 70)
    print(f"您的輸入:\n  \"{msg}\"\n")
    print("請遵循以下兩種標準格式之一：\n")
    print("【類別 A - 系統程式碼 (Code/Tools/Engine)】:")
    print("  * feat(模組): 說明    (例: feat(cloud): add background gcs auto-sync)")
    print("  * fix(模組): 說明     (例: fix(backlot): fix player layout)")
    print("  * docs: 說明          (例: docs: update setup guide)")
    print("  * test(模組): 說明    (例: test(gcs): add auto sync tests)")
    print("\n【類別 B - 課程與配方資料 (Course Content/Projects)】:")
    print("  * content(課程名): 說明 (例: content(course-31): update sequence 5 script)")
    print("  * data(課程名): 說明    (例: data(esg): approve episode 1 pilot checkpoints)")
    print("\n[!] 提示：您完全不需要手動記格式！")
    print("   請直接執行以下指令，系統會自動辨識並幫您提交：")
    print("   -> python scripts/om_commit.py")
    print("=" * 70 + "\n")
    sys.exit(1)

# -------------------------------------------------------------
# 2. Staged Content Awareness Validation
# -------------------------------------------------------------
def get_staged_files():
    try:
        res = subprocess.run(["git", "diff", "--cached", "--name-only"], capture_output=True, text=True, encoding="utf-8")
        return [f.strip().replace("\\", "/") for f in res.stdout.splitlines() if f.strip()]
    except Exception:
        return []

staged_files = get_staged_files()
if staged_files:
    # A. Binary Shield: Block heavy media assets from entering Git
    BINARY_EXTS = {
        ".mp4", ".mov", ".webm", ".avi", ".mkv",
        ".mp3", ".wav", ".m4a", ".aac", ".flac", ".ogg",
        ".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".ico",
        ".onnx", ".pth", ".pt", ".bin"
    }
    bad_binaries = [f for f in staged_files if any(f.lower().endswith(ext) for ext in BINARY_EXTS)]
    if bad_binaries:
        print("\n" + "=" * 70)
        print("[X] [OpenMontage 規範守門員 - 二進位防護盾] 禁止提交多媒體/二進位檔案！")
        print("=" * 70)
        print(f"偵測到您試圖將媒體檔案提交進 Git (共 {len(bad_binaries)} 個)：")
        for b in bad_binaries[:5]:
            print(f"  * {b}")
        if len(bad_binaries) > 5:
            print(f"  * ... 還有另外 {len(bad_binaries) - 5} 個檔案")
        print("\n[!] 規範說明：")
        print("  所有影片、音訊與圖片請存放於 GCS 雲端儲存庫，Git 僅保留純文字配方 (JSON/Code)。")
        print("  請執行: git reset HEAD <檔案> 將其移出暫存區。")
        print("=" * 70 + "\n")
        sys.exit(1)

    # B. No Mixed Commits: Prevent mixing system code with course data
    course_files = [f for f in staged_files if f.startswith("projects/")]
    code_files = [f for f in staged_files if not f.startswith("projects/")]

    if course_files and code_files:
        print("\n" + "=" * 70)
        print("[X] [OpenMontage 規範守門員 - 分類檢驗] 偵測到「混雜提交」！")
        print("=" * 70)
        print("您不能在同一個 Commit 裡同時提交【系統程式碼】與【課程資料】：")
        print(f"\n  [系統程式碼 ({len(code_files)} 個)]:")
        for c in code_files[:3]:
            print(f"    - {c}")
        print(f"\n  [課程配方資料 ({len(course_files)} 個)]:")
        for cf in course_files[:3]:
            print(f"    - {cf}")
        print("\n[!] 解決方式：")
        print("  請將二者分開提交，或直接執行以下指令讓智慧助手幫您分批打包：")
        print("  -> python scripts/om_commit.py")
        print("=" * 70 + "\n")
        sys.exit(1)

    # C. Semantic Consistency: Ensure message matches staged files
    if is_cat_b and code_files and not course_files:
        print("\n" + "=" * 70)
        print("[X] [OpenMontage 規範守門員 - 名實不符阻斷]")
        print("=" * 70)
        print(f"您的 Commit 訊息使用了類別 B (課程配方資料):")
        print(f"  \"{msg}\"")
        print(f"但暫存區內實際修改的是【系統程式碼】({len(code_files)} 個檔案，如 {code_files[0]})！")
        print("\n請改用類別 A 格式 (如: feat(模組): 說明 或 fix(模組): 說明)！")
        print("=" * 70 + "\n")
        sys.exit(1)

    if is_cat_a and course_files and not code_files:
        print("\n" + "=" * 70)
        print("[X] [OpenMontage 規範守門員 - 名實不符阻斷]")
        print("=" * 70)
        print(f"您的 Commit 訊息使用了類別 A (系統程式碼):")
        print(f"  \"{msg}\"")
        print(f"但暫存區內實際修改的全是【課程配方資料】(projects/ 下共 {len(course_files)} 個檔案)！")
        print("\n請改用類別 B 格式：")
        print("  -> content(<課程名>): 說明")
        print("  例: content(course-31): update sequence 5 script")
        print("=" * 70 + "\n")
        sys.exit(1)

# All validations passed!
sys.exit(0)
EOF
