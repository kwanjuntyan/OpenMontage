{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/execution/production-unit-handoff-record/1.0",
  "title": "Production Unit candidate handoff immutable record",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "required": [
        "handoff_id",
        "project_id",
        "run_id",
        "pipeline_type",
        "stage",
        "execution_epoch",
        "control_chain"
      ],
      "additionalProperties": false,
      "properties": {
        "handoff_id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "pipeline_type": { "$ref": "#/$defs/identifier" },
        "stage": {
          "type": "string",
          "enum": ["script", "clp", "scene_plan", "edit"]
        },
        "execution_epoch": { "type": "integer", "minimum": 0 },
        "control_chain": {
          "type": "object",
          "required": ["chain_id", "event_sequence", "sha256"],
          "additionalProperties": false,
          "properties": {
            "chain_id": { "$ref": "#/$defs/identifier" },
            "event_sequence": { "type": "integer", "minimum": 0 },
            "sha256": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "checkpointRef": {
      "type": "object",
      "required": ["stage", "logical_path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "stage": { "$ref": "#/$defs/identifier" },
        "logical_path": {
          "type": "string",
          "pattern": "^checkpoint_[A-Za-z0-9_-]+\\.json$"
        },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "targetCheckpointRef": {
      "type": "object",
      "required": ["stage", "logical_path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "stage": { "$ref": "#/$defs/identifier" },
        "logical_path": {
          "type": "string",
          "pattern": "^checkpoint_[A-Za-z0-9_-]+\\.json$"
        },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "version", "record_type", "identity", "policy_checkpoint",
        "policy_sha256", "execution_contract", "execution_contract_sha256",
        "plan", "plan_sha256", "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "record_type": { "const": "plan" },
        "identity": { "$ref": "#/$defs/identity" },
        "policy_checkpoint": { "$ref": "#/$defs/checkpointRef" },
        "policy_sha256": { "$ref": "#/$defs/digest" },
        "execution_contract": { "type": "object" },
        "execution_contract_sha256": { "$ref": "#/$defs/digest" },
        "plan": { "type": "object" },
        "plan_sha256": { "$ref": "#/$defs/digest" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    {
      "type": "object",
      "required": [
        "version", "record_type", "identity", "publication_authority",
        "plan_record_sha256", "policy_checkpoint", "policy_sha256",
        "source_checkpoints", "target_checkpoint_before", "artifact_names",
        "artifacts", "candidate_sha256", "merge_evidence",
        "merge_evidence_sha256", "provider_charge_state", "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "record_type": { "const": "candidate" },
        "identity": { "$ref": "#/$defs/identity" },
        "publication_authority": { "const": "pup_json_merge" },
        "plan_record_sha256": { "$ref": "#/$defs/digest" },
        "policy_checkpoint": { "$ref": "#/$defs/checkpointRef" },
        "policy_sha256": { "$ref": "#/$defs/digest" },
        "source_checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkpointRef" }
        },
        "target_checkpoint_before": { "$ref": "#/$defs/targetCheckpointRef" },
        "artifact_names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "artifacts": { "type": "object", "minProperties": 1 },
        "candidate_sha256": { "$ref": "#/$defs/digest" },
        "merge_evidence": { "type": "object" },
        "merge_evidence_sha256": { "$ref": "#/$defs/digest" },
        "provider_charge_state": { "const": "not_applicable" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    {
      "type": "object",
      "required": [
        "version", "record_type", "identity", "authority",
        "candidate_record_sha256", "candidate_sha256", "decision",
        "review_evidence", "review_evidence_sha256", "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "record_type": { "const": "review" },
        "identity": { "$ref": "#/$defs/identity" },
        "authority": { "const": "stage_review_only" },
        "candidate_record_sha256": { "$ref": "#/$defs/digest" },
        "candidate_sha256": { "$ref": "#/$defs/digest" },
        "decision": { "type": "string", "enum": ["accepted", "rejected"] },
        "review_evidence": { "type": "object" },
        "review_evidence_sha256": { "$ref": "#/$defs/digest" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    {
      "type": "object",
      "required": [
        "version", "record_type", "identity", "authority",
        "candidate_record_sha256", "candidate_sha256", "review_record_sha256",
        "outcome", "validated_artifact_digests", "checkpoint_target_status",
        "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "record_type": { "const": "validation" },
        "identity": { "$ref": "#/$defs/identity" },
        "authority": { "const": "canonical_artifact_validator" },
        "candidate_record_sha256": { "$ref": "#/$defs/digest" },
        "candidate_sha256": { "$ref": "#/$defs/digest" },
        "review_record_sha256": { "$ref": "#/$defs/digest" },
        "outcome": { "const": "passed" },
        "validated_artifact_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/digest" }
        },
        "checkpoint_target_status": {
          "type": "string",
          "enum": ["completed", "awaiting_human"]
        },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    {
      "type": "object",
      "required": [
        "version", "record_type", "identity", "publication_authority",
        "candidate_record_sha256", "candidate_sha256", "review_record_sha256",
        "validation_record_sha256", "target_checkpoint_before",
        "target_status", "human_approved", "review", "cost_snapshot",
        "metadata", "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "record_type": { "const": "checkpoint_intent" },
        "identity": { "$ref": "#/$defs/identity" },
        "publication_authority": { "const": "pup_json_merge" },
        "candidate_record_sha256": { "$ref": "#/$defs/digest" },
        "candidate_sha256": { "$ref": "#/$defs/digest" },
        "review_record_sha256": { "$ref": "#/$defs/digest" },
        "validation_record_sha256": { "$ref": "#/$defs/digest" },
        "target_checkpoint_before": { "$ref": "#/$defs/targetCheckpointRef" },
        "target_status": {
          "type": "string",
          "enum": ["completed", "awaiting_human"]
        },
        "human_approved": { "const": false },
        "review": { "type": ["object", "null"] },
        "cost_snapshot": { "type": ["object", "null"] },
        "metadata": { "type": "object" },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    {
      "type": "object",
      "required": [
        "version", "record_type", "identity", "publication_authority",
        "checkpoint_intent_sha256", "candidate_sha256", "checkpoint",
        "status", "human_approved", "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "record_type": { "const": "checkpoint_receipt" },
        "identity": { "$ref": "#/$defs/identity" },
        "publication_authority": { "const": "pup_json_merge" },
        "checkpoint_intent_sha256": { "$ref": "#/$defs/digest" },
        "candidate_sha256": { "$ref": "#/$defs/digest" },
        "checkpoint": { "$ref": "#/$defs/checkpointRef" },
        "status": {
          "type": "string",
          "enum": ["completed", "awaiting_human"]
        },
        "human_approved": { "const": false },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  ]
}
