{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/execution/batch_result.schema.json",
  "title": "Batch Executor V2 BatchResult",
  "type": "object",
  "required": [
    "version",
    "batch_id",
    "request_digest",
    "source_bindings",
    "invocations",
    "ownership_proof_digests",
    "status",
    "outcome",
    "counts",
    "items",
    "cost",
    "statistics",
    "agent_review_hints",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "batch_id": { "$ref": "#/$defs/id" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["binding_id", "sha256"],
        "additionalProperties": false,
        "properties": {
          "binding_id": { "$ref": "#/$defs/id" },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "invocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["invocation_id", "execution_id", "profile"],
        "additionalProperties": false,
        "properties": {
          "invocation_id": { "$ref": "#/$defs/id" },
          "execution_id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "profile": { "enum": ["local", "cloud_run"] }
        }
      }
    },
    "ownership_proof_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "status": { "const": "awaiting_agent_review" },
    "outcome": { "enum": ["all_succeeded", "partial_failure", "failed", "cancelled", "indeterminate"] },
    "counts": {
      "type": "object",
      "required": ["successful", "cache_hit", "failed", "blocked", "indeterminate", "cancelled"],
      "additionalProperties": false,
      "properties": {
        "successful": { "type": "integer", "minimum": 0 },
        "cache_hit": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "indeterminate": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["item_id", "state"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "$ref": "#/$defs/id" },
          "state": { "enum": ["committed", "failed_terminal", "blocked_by_dependency", "indeterminate", "cancelled", "cache_hit"] },
          "storage_receipt": { "$ref": "storage_receipt.schema.json" },
          "error": {
            "type": "object",
            "required": ["error_class", "sanitized_message"],
            "additionalProperties": false,
            "properties": {
              "error_class": { "$ref": "attempt.schema.json#/$defs/error_class" },
              "sanitized_message": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "blocker": { "$ref": "#/$defs/dependency_blocker" }
        }
      }
    },
    "cost": { "$ref": "#/$defs/cost" },
    "statistics": {
      "type": "object",
      "required": ["attempts", "retries", "cache_hits", "rate_limit_wait_seconds"],
      "additionalProperties": false,
      "properties": {
        "attempts": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "rate_limit_wait_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "agent_review_hints": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dependency_blocker": {
      "type": "object",
      "required": ["kind", "dependency_item_ids", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "dependency_failure" },
        "dependency_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "cost": {
      "type": "object",
      "required": ["estimated_usd", "reserved_usd", "known_actual_usd", "indeterminate_exposure_usd", "authorized_cap_usd"],
      "additionalProperties": false,
      "properties": {
        "estimated_usd": { "type": "number", "minimum": 0 },
        "reserved_usd": { "type": "number", "minimum": 0 },
        "known_actual_usd": { "type": "number", "minimum": 0 },
        "indeterminate_exposure_usd": { "type": "number", "minimum": 0 },
        "authorized_cap_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
