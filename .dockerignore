# Batch V2 uses a repository-root, default-deny Docker build context.
**

# Exact runtime inputs used by Dockerfile.batch-v2.
!Dockerfile.batch-v2
!.dockerignore
!requirements-batch-v2.txt
!constraints-batch-v2-py310.txt
!lib/
!lib/**
!schemas/
!schemas/**
!pipeline_defs/
!pipeline_defs/**
!scripts/
!scripts/batch_execute.py
!scripts/batch_publish.py

# Defense in depth: these stay excluded even beneath an allowed directory.
.git
.git/**
**/.git
**/.git/**
.env
.env*
**/.env
**/.env*
projects
projects/**
**/projects/**
generated
generated/**
**/generated/**
**/*.mp4
**/*.mov
**/*.webm
**/*.mkv
**/*.avi
**/*.mp3
**/*.wav
**/*.flac
**/*.aac
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*credential*.json
**/*credentials*.json
**/*service-account*.json
**/*service_account*.json
**/*serviceaccount*.json
**/*-key.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
__pycache__
__pycache__/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
.pytest_cache/**
**/.pytest_cache
**/.pytest_cache/**
.pytest-tmp*
.pytest-tmp*/**
**/.pytest-tmp*
**/.pytest-tmp*/**
.ruff_cache
.ruff_cache/**
**/.ruff_cache
**/.ruff_cache/**
.mypy_cache
.mypy_cache/**
**/.mypy_cache
**/.mypy_cache/**
.cache
.cache/**
**/.cache
**/.cache/**
.coverage*
htmlcov
htmlcov/**
coverage*
test-results
test-results/**
tests
tests/**
tmp
tmp/**
temp
temp/**
**/*.tmp
**/*.log
node_modules
node_modules/**
**/node_modules
**/node_modules/**
.worktrees
.worktrees/**
worktrees
worktrees/**
